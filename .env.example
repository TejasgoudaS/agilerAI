# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION ENV — these are set as Render environment variables (Render
# dashboard → your service → Environment), not a committed file. render.yaml
# references these keys with `sync: false`/`generateValue: true` so Render
# prompts you for them (or generates them) instead of reading this file
# directly. This file is just the reference template — NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Backend secrets (server-side only — safe to keep here) ────────────────
# Used as the server-side fallback OpenAI key when a user hasn't configured
# their own key in Settings. Also seeds the FIRST registered user's
# WorkspaceConfig (see auth.py `_seed_workspace_from_env`).
VITE_OPENAI_API_KEY=sk-proj-your-key-here

# JWT signing secret — render.yaml sets `generateValue: true` so Render
# generates a strong random one for you automatically. If setting it manually:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-long-random-value-here

# Fernet key for encrypting API keys/tokens at rest. If unset, auth.py derives
# one deterministically from JWT_SECRET_KEY — fine here, but setting an
# explicit key is more correct if you ever migrate databases:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# REQUIRED on Render: free web services have no persistent disk, so local
# SQLite would reset on every sleep/wake cycle, not just redeploys. Use a free
# managed Postgres instead (Neon.tech recommended — no time-based expiry,
# unlike Render's own free Postgres which auto-deletes after 30 days). See
# DEPLOYMENT.md Part B0 for how to create one and get this connection string.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# ── Jira seed (optional) ───────────────────────────────────────────────────
# Only seeds the FIRST registered user's workspace. In production, every user
# configures their own Jira connection via the in-app Settings modal instead —
# leave these blank unless you specifically want a pre-seeded demo account.
VITE_JIRA_BASE_URL=
VITE_JIRA_EMAIL=
VITE_JIRA_API_TOKEN=
VITE_JIRA_PROJECT_KEY=

# ─────────────────────────────────────────────────────────────────────────
# IMPORTANT — Vercel (frontend) build env vars:
# Do NOT set VITE_OPENAI_API_KEY, VITE_JIRA_EMAIL, or VITE_JIRA_API_TOKEN as
# Vercel project env vars. Vite bakes any VITE_* var into the public JS
# bundle at build time — anyone could open devtools and read them. The app's
# primary path (the backend-proxied CrewAI pipeline) never needs these
# client-side; they only power a client-side direct-OpenAI fallback meant
# for local dev when the backend is unreachable. Leave Vercel's env vars
# empty and let that fallback simply stay unavailable in production.
# ─────────────────────────────────────────────────────────────────────────
